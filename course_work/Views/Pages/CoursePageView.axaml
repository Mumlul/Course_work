<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="course_work.Views.Pages.CoursePageView"
             x:DataType="vm:CoursePageViewModel">
    <Grid RowDefinitions="200,*">
        <!--Image-->
        <Grid>
            <Image Source="{Binding Image}"
                   Stretch="UniformToFill"/>

            <StackPanel Classes="ImageActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Spacing="6"
                        IsVisible="{Binding IsAuthor}"
                        >
                <Button Content="+"/>
                <Button Content="-"/>
            </StackPanel>
        </Grid>
       
        <Grid RowDefinitions="Auto,*" Grid.Row="1" Classes="Main">
            <!--Header-->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Width="1100"
                  HorizontalAlignment="Center"
                  Margin="0,20">

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Currentcourse.Title}"
                               FontSize="40"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding Currentcourse.Description}"
                               FontSize="24"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsTracked}"
                              IsVisible="{Binding IsAuthor,Converter={StaticResource ToggleButtonAuthor}}"
                              VerticalAlignment="Top"
                              Margin="20,6,0,0">
                    <Panel>
                        <TextBlock Classes="track-off" Text="Отслеживать"/>
                        <TextBlock Classes="track-on" Text="Отслеживается"/>
                    </Panel>
                </ToggleButton>

            </Grid>
        
            <!--Main-->
            <Grid Grid.Row="1" RowDefinitions="*,Auto">
                    <ListBox 
                        ItemsSource="{Binding Module}" 
                        Width="1100" 
                        Background="Transparent"
                        SelectedValueBinding=""
                        SelectedItem="{Binding SelectedModule}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Grid.Row="2" CornerRadius="10"  Width="400" Height="300" ClipToBounds="True">  
                                    <Grid RowDefinitions="2*,*">
                                        <Image 
                                            Source="{Binding PreviewImage,Converter={StaticResource UrlToBitmapConverter}}" 
                                            Stretch="UniformToFill"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                <Button Grid.Row="1" Content="Добавить модуль" 
                        Classes="AddВutton" 
                        IsVisible="{Binding IsAuthor}" 
                        Command="{Binding AddModuleCommand}"/>
            </Grid>
        </Grid>
        
        
        
        <!--Это для читаателей-->
        <Grid Grid.RowSpan="3" 
              IsVisible="{Binding IsDialogOpen}"
              Background="#80000000"
              ZIndex="1">
            
            <Border Width="1000"
                    Height="700"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                
                <Grid RowDefinitions="Auto,200,Auto,*">
                    <Button Content="Закрыть" Command="{Binding CloseCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    <Grid Grid.Row="1">
                        <Image Source="{Binding ModuleImage}"
                               Stretch="UniformToFill"/>

                        <StackPanel Classes="ImageActions"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Spacing="6"
                                    IsVisible="{Binding IsAuthor}">
                            
                            <Button Content="+" Command="{Binding ChangeImageCommand}"/>
                            <Button Content="Удалить"/>
                        </StackPanel>
                    </Grid>

                    <!--Title-->
                    <TextBox 
                        Padding="20" 
                        Grid.Row="2" 
                        Text="{Binding SelectedModule.Title}" 
                        DockPanel.Dock="Top" 
                        Classes="ChangeText"/>
                    
                    
                    <!--Lesson List-->
                    <Grid Grid.Row="3" RowDefinitions="*,Auto" >
                        <ListBox  
                             Classes="ModulePreview"
                             ItemsSource="{Binding  Lessons}"
                             SelectedItem="{Binding SelectedLesson}"
                             Padding="20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Classes="h1" Text="{Binding Lesson.Title}"/>
                                        <TextBlock Classes="second" Text="{Binding CompletedText}" IsVisible="{Binding IsVisible}"/> 
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <Button Classes="AddВutton" 
                                Grid.Row="1" 
                                Content="Добавить урок" 
                                Command="{Binding AddLessonCommand}" 
                                IsVisible="{Binding IsAuthor}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
