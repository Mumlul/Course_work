<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="course_work.Views.Pages.CoursePageView"
             x:DataType="vm:CoursePageViewModel">
    <Grid RowDefinitions="200,*">
        <!--Image-->
        <Grid>
            <Image Source="{Binding Image}"
                   Stretch="UniformToFill"/>

            <StackPanel Classes="ImageActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Spacing="6"
                        IsVisible="{Binding IsAuthor}"
                        >
                <Button Content="+"/>
                <Button Content="-"/>
            </StackPanel>
        </Grid>
       
        <Grid RowDefinitions="Auto,*" Grid.Row="1" Classes="Main">
            <!--Header-->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Currentcourse.Title}" FontSize="40"  FontWeight="Bold" HorizontalAlignment="Center"/> 
                    <Button Content="Отслеживать" Command="{Binding TrackCourseCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Currentcourse.Description}" FontSize="24"/>
            </StackPanel>
        
            <!--Main-->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
                <ListBox 
                    ItemsSource="{Binding Module}" 
                    Width="1100" 
                    Background="Transparent"
                    SelectedValueBinding=""
                    SelectedItem="{Binding SelectedModule}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Grid.Row="2" CornerRadius="10"  Width="400" Height="300" ClipToBounds="True">  
                                <Grid RowDefinitions="2*,*">
                                    <Image 
                                        Source="{Binding PreviewImage,Converter={StaticResource UrlToBitmapConverter}}" 
                                        Stretch="UniformToFill"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="+" 
                        Classes="AddModule" 
                        IsVisible="{Binding IsAuthor}" 
                        Command="{Binding AddModuleCommand}"/>
            </Grid>
        </Grid>
        
        
        
        <!--Это для читаателей-->
        <Grid Grid.RowSpan="3" 
              IsVisible="{Binding IsDialogOpen}"
              Background="#80000000"
              ZIndex="1">
            
            <Border Width="1000"
                    Height="700"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                
                <Grid RowDefinitions="Auto,200,Auto,*">
                    <Button Content="Закрыть" Command="{Binding CloseCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    <Grid Grid.Row="1">
                        <Image Source="{Binding ModuleImage}"
                               Stretch="UniformToFill"/>

                        <StackPanel Classes="ImageActions"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Spacing="6"
                                    IsVisible="{Binding IsAuthor}">
                            
                            <Button Content="+" Command="{Binding ChangeImageCommand}"/>
                            <Button Content="Удалить"/>
                        </StackPanel>
                    </Grid>

                    
                    <TextBox Padding="20" Grid.Row="2" Text="{Binding SelectedModule.Title}" DockPanel.Dock="Top" Classes="ChangeText"/>
                    
                    <Grid Grid.Row="3" RowDefinitions="*,Auto" >
                        <ListBox  ItemsSource="{Binding  Lessons}"
                                 SelectedItem="{Binding SelectedLesson}"
                                 Padding="20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="1" Content="Добавить урок" Command="{Binding AddLessonCommand}" IsVisible="{Binding IsAuthor}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
