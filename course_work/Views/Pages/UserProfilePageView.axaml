<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1200"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             xmlns:conv="clr-namespace:course_work.Convertors"
             xmlns:service="clr-namespace:course_work.Services.Service"
             x:DataType="vm:UserProfilePageViewModel"
             HorizontalAlignment="Center"
             x:Class="course_work.Views.Pages.UserProfilePageView">
    
    
    <Grid ColumnDefinitions="300,*" Classes="Main" Margin="20" ColumnSpacing="20" MinWidth="1100">
        <Border Classes="Profile" Padding="20" CornerRadius="14">
            <StackPanel Spacing="30" HorizontalAlignment="Center">

                <Border Classes="BigImage" Width="200" Height="200" CornerRadius="100" ClipToBounds="True">
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Classes="h1" Text="{Binding User.Name}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Автор" Classes="second" IsVisible="{Binding IsAuthor}" FontSize="14" Foreground="Gray" TextAlignment="Center"/>
                </StackPanel>
                
                <Button Content="Изменить фото профиля" 
                        Command="{Binding ChangeAvatarCommand}" 
                        IsVisible="{Binding IsUser}"
                        HorizontalAlignment="Center"/>
                
                <Button Content="Подать претензию"
                        Command="{Binding OpenClaimCommand}"
                        IsVisible="{Binding !IsUser}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
            <StackPanel Spacing="20">
                
                <TextBlock Text="Завершенные курсы" FontSize="28" FontWeight="Bold" Margin="10,0"/>
                
                <ListBox ItemsSource="{Binding CompleteCurse}" SelectedItem="{Binding SelectedCourse}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="300" ItemHeight="350" Margin="0" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="PreviewCard" CornerRadius="14" ClipToBounds="True" Margin="10">
                                <Grid RowDefinitions="180,*">
                                    <Grid>
                                        <Image
                                            service:ImageExtensions.SourceUrl="{Binding PreviewImage}" Stretch="UniformToFill" />
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border  Padding="12" CornerRadius="23">
                    <TextBlock Text="{Binding Profile.Description}" 
                               TextWrapping="Wrap"
                               MaxWidth="800"/>
                </Border>
                
                
                <TabControl>
                    <TabItem Header="Текущие курсы">
                        <ListBox ItemsSource="{Binding Courses}"
                                 SelectedItem="{Binding SelectedCourse}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Пройденое тестирование">
                        <ListBox ItemsSource="{Binding CompleteTest}"
                                 SelectedItem="{Binding SelectedCourse}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Test.Title}" />
                                        <TextBlock Text="{Binding Score, StringFormat='С баллом {0:F2}'}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Авторство" IsVisible="{Binding IsAuthor}">
                        <ListBox ItemsSource="{Binding AllCursesAuthor}"
                                 SelectedItem="{Binding SelectedCourse}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
                
            </StackPanel>
        </ScrollViewer>

        <Grid ColumnSpan="2"
              IsVisible="{Binding OpenClaimButton}"
              Background="#80000000"
              ZIndex="10">
            <Border Width="600"
                    Height="300"
                    CornerRadius="14"
                    Background="#2B2B2B"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20">

                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="Пожаловаться на пользователя"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding ClaimMessage}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Watermark="Опишите проблему..."
                             Margin="0,20,0,0"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10"
                                Margin="0,20,0,0">

                        <Button Content="Отмена"
                                Command="{Binding CloseClaimCommand}"/>

                        <Button Content="Отправить"
                                Command="{Binding AddClaimCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
