<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1200"
             x:Class="course_work.Views.Pages.AddCoursePageView"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             xmlns:service="clr-namespace:course_work.Services.Service"
             x:DataType="vm:AddCoursePageViewModel"
             >
    <Grid RowDefinitions="300,*">
        <Grid Grid.Row="0" RowDefinitions="200,Auto">
            <Image
                service:ImageExtensions.SourceUrl="{Binding Image}" Stretch="UniformToFill" />
            <StackPanel Grid.Row="1" Spacing="5">
                <TextBlock Text="Превью изображения:" FontWeight="SemiBold"/>
                <Button Content="Изменить фото курса" Command="{Binding SelectPhotoCommand}"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Создание нового курса" FontSize="20" FontWeight="Bold"/>
            <TextBox Grid.Row="1" Text="{Binding NewCourse.Title}" Watermark="Название курса" MinHeight="30"/>
            <TextBox Grid.Row="2" Text="{Binding NewCourse.Description}" 
                     Watermark="Описание курса" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
            <TextBox Grid.Row="3" Text="{Binding NewCourse.Slug}" Watermark="Краткое название" MinHeight="30"/>
            
            <Button Grid.Row="4" Content="Создать курс" Command="{Binding CreateCourseCommand}" Width="120" Height="35"/>
        </Grid>
    </Grid>
</UserControl>
