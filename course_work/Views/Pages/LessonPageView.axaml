<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             x:DataType="vm:LessonPageViewModel"
             x:Class="course_work.Views.Pages.LessonPageView"
             xmlns:avrtb="using:AvRichTextBox"
             xmlns:cc="using:CustomControls"
             xmlns:tpl="clr-namespace:course_work.Template"
             xmlns:models="clr-namespace:course_work.Models">
    <!--<UserControl.Resources>
        <tpl:BlockTemplateSelector x:Key="BlockTemplateSelector"/>
    </UserControl.Resources>-->
    
    
    <Grid RowDefinitions="200,Auto,*">
        <!--Image-->
        <Grid>
            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
            <StackPanel Classes="ImageActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Spacing="6"
                        IsVisible="{Binding IsAuthor}"
            >
                <Button Content="+" Command="{Binding ChangeImageCommand}"/>
                <!--<Button Content="-"/>-->
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
            <!-- Пусто слева для баланса -->
            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentLesson.Title}"
                       FontSize="40"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <Button Grid.Column="2"
                    Content="Закрыть"
                    Command="{Binding SaveAllBlocksToWordCommand}"
                    HorizontalAlignment="Right"/>
        </Grid>
        
        <Grid Grid.Row="2" Classes="Main" RowDefinitions="Auto,Auto,Auto">
            <!--Это поле с редактированием-->
            <!--Автор-->
            <Border Grid.Row="0"  Padding="16" IsVisible="{Binding IsAuthor}">
                <StackPanel Orientation="Horizontal">
                    <DockPanel DockPanel.Dock="Top" Margin="4">
                        <ColorPicker ColorChanged="FontCP_ColorChanged" DockPanel.Dock="Right"/>
                        <TextBlock Text="Цвет текста:" HorizontalAlignment="Right" Margin="3,0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="2">
                        <ColorPicker ColorChanged="HighlightCP_ColorChanged" DockPanel.Dock="Right"/>
                        <TextBlock Text="Выделение текста:" VerticalAlignment="Center" Margin="3,0"/>
                    </DockPanel>

                    <DockPanel Margin="2">
                        <TextBlock Text="Размер шрифта:" VerticalAlignment="Center" Margin="3,0"/>
                        <cc:NumericSpinner x:Name="FontSizeNS" MinValue="5" MaxValue="72" Value="14" Width="50" Height="25" UserValueChanged="FontSizeNS_UserValueChanged"/>
                    </DockPanel>

                    <DockPanel Margin="2">
                        <TextBlock Text="Выравнивание:" VerticalAlignment="Center" Margin="3,0"/>
                        <ComboBox x:Name="JustificationCB" Width="100" DropDownClosed="JustificationComboBox_DropDownClosed">
                            <ComboBoxItem Content="Left"/>
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Right"/>
                            <ComboBoxItem Content="Justified"/>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </Border>
            
            <!--Автор-->
            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="BlocksItemsControl" ItemsSource="{Binding Blocks}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="models:TextBlockModel">
                            <avrtb:RichTextBox
                                Loaded="RichTextBox_Loaded"
                                GotFocus="RichTextBox_GotFocus"/>
                        </DataTemplate>
                        
                        <DataTemplate DataType="models:ImageBlockModel">
                            <Image  Source="{Binding ImagePath,Converter={StaticResource UrlToBitmapConverter}}" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        
            <Grid Grid.Row="2" ColumnDefinitions="*,*" IsVisible="{Binding IsAuthor}">
                <Button Grid.Column="0"
                        Content="Добавить параграф"
                        Command="{Binding AddTextBlockCommand}"
                        HorizontalAlignment="Left"/>

                <Button Grid.Column="1"
                        Content="Добавить изображение"
                        Command="{Binding AddImageBlockCommand}"
                        HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="2" IsVisible="{Binding !IsAuthor}">
                <ToggleButton IsChecked="{Binding IsCompleted}" Command="{Binding CompleteLessonCommand}">
                    <Panel>
                        <TextBlock Text="Пройден" Classes="Passed"/>
                        <TextBlock Text="Завершить урок" Classes="NotPassed"/>
                    </Panel>
                </ToggleButton>
            </Grid>
        
        </Grid>
    </Grid>
</UserControl>
