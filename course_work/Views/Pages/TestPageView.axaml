<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Width="1100"
             x:Class="course_work.Views.Pages.TestPageView"
             xmlns:vm="clr-namespace:course_work.ViewModels.Pages"
             xmlns:class="clr-namespace:course_work.Models.Classes"
             x:DataType="vm:TestPageViewModel">
    <Grid>
        <ScrollViewer>
        <StackPanel Spacing="24" Margin="20">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding CurrentTest.Title}"
                           FontSize="32"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding CurrentTest.Description}"
                           FontSize="18"
                           TextWrapping="Wrap"/>
            </StackPanel>
                <ItemsControl ItemsSource="{Binding CurrentTest.Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="class:TestQuestion">
                            <Border BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{Binding QuestionText}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="class:TestQuestionOption">
                                                <RadioButton Content="{Binding OptionText}"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             GroupName="{Binding Question.Id}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                    <Button Content="Сдать тест" Command="{Binding FinishTestCommand}" Background="#4CAF50" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <Border IsVisible="{Binding IsCompleted}" Width="300" Height="300">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

                <TextBlock Text="{Binding TestResultMessage}" 
                           FontSize="18"
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"/>

                <Button Content="Пройти к аккаунту" 
                        Command="{Binding GoProfileCommand}" 
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
    </Grid>
    
    
    
</UserControl>
